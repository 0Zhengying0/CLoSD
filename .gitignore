# Local reproduction resources
/.local/
/reproduction/release-assets/

# Keep experiment evidence visible to Git, including Slurm .out/.err logs,
# result tables, trajectories, videos, checkpoints and reflow pairs.
# GitHub file-size limits still apply when these files are uploaded.
!/reproduction/scripts/hpc/jobs.json
!/logs/**
!/reproduction/logs/**
!/reproduction/experiments/*/runs/
!/reproduction/experiments/*/runs/**
!/reproduction/runs/
!/reproduction/runs/**
!/reproduction/reflow_pairs/**
!/reproduction/ode_smoke/**

# Result files currently above GitHub's 100 MiB regular Git object limit.
# Keep smaller smoke pairs, W&B runs, logs, tables and videos visible.
/reproduction/runs/*/*.pt
/reproduction/reflow_pairs/rf1_300k_heun10_seed*.pt
/reproduction/experiments/dip_fm_quality/runs/*/execution/*/episodes.pkl
/reproduction/runs/wandb/wandb/offline-run-*-DiP_multi-target_repro_seed10/run-DiP_multi-target_repro_seed10.wandb
